<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: cloud backup and device-to-device transfer, with the same exclusions in both.
    See backup_rules.xml for why each file is left out; keep the two files in sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app.giftiary_preferences.xml" />
        <exclude domain="sharedpref" path="giftiary_account_deletion.xml" />
        <exclude domain="database" path="giftiary.db" />
        <exclude domain="database" path="giftiary.db-wal" />
        <exclude domain="database" path="giftiary.db-shm" />
        <exclude domain="database" path="giftiary.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app.giftiary_preferences.xml" />
        <exclude domain="sharedpref" path="giftiary_account_deletion.xml" />
        <exclude domain="database" path="giftiary.db" />
        <exclude domain="database" path="giftiary.db-wal" />
        <exclude domain="database" path="giftiary.db-shm" />
        <exclude domain="database" path="giftiary.db-journal" />
    </device-transfer>
</data-extraction-rules>
