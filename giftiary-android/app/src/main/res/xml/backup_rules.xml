<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 8–11. Everything is backed up except the Supabase Auth session. -->
<full-backup-content>
    <!--
        supabase-kt keeps the session (with its refresh token) and the PKCE code verifier in the
        default SharedPreferences, "<applicationId>_preferences" (multiplatform-settings no-arg).
        A restored session would sign another device in without a password; signing in again
        there is the safer default. Keep in sync with data_extraction_rules.xml.
    -->
    <exclude domain="sharedpref" path="app.giftiary_preferences.xml" />
</full-backup-content>
